# Server-only. Configure secrets in local .env.local or secure hosting settings.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback
# Conservative request limits; adjust against your project's current Google quotas.
GOOGLE_WRITE_REQUESTS_PER_MINUTE=30
GOOGLE_PROJECT_WRITES_PER_MINUTE=300

# Private laboratory: local HTTPS + NODE_ENV=development only. Disabled on Vercel/production.
TYPEFLOW_DEVELOPER_ENABLED=
TYPEFLOW_DEVELOPER_ORIGIN=
TYPEFLOW_DEVELOPER_PASSWORD_HASH=
TYPEFLOW_DEVELOPER_SESSION_SECRET=
# Optional comma-separated verified administrator Google email addresses.
TYPEFLOW_DEVELOPER_GOOGLE_ALLOWLIST=
